desc:Transient Shuffler
//author: Kallum Shah
//version: 1.0
//about:
//  Give one sample the attack of another. Drop two samples on the window:
//  the result keeps A's body (its sustain and tail) and takes B's attack, or
//  the other way round. Play it from the window or with MIDI notes, and print
//  it to the project as a new item.
//tags: sampler transient drum hybrid instrument

/*
  How the swap works

  1. Each sample's hit is found: the first moment it gets within the onset
     threshold of its own peak. The two hits are lined up there.
  2. Up to the attack length after the hit (plus 5 ms before it, so the
     rise isn't clipped) the result is the attack sample.
  3. From the attack length the two are crossfaded. With "Align phase" on,
     the body is first slid up to 2.5 ms (and flipped if that matches
     better) so the splice adds rather than cancels; the crossfade's shape
     follows how alike the two are there, so the level holds either way.
  4. After the crossfade it is the body sample, untouched.

  With "Find attack" on, the attack length is where the attack sample's own
  attack ends, measured from the sound (find_attack_end, decision 0012).
  With "Snap to zero crossings" on, the splice moves up to 5 ms to where
  both sounds cross zero together (0013).

  "Match level" scales the borrowed attack so its peak equals the body
  sample's own attack peak: the result is as loud as the sample it replaces.

  Colours are the house scheme (Good Idea's docs/COLOUR.md, as in
  Miderator's Theme.h): a dark cool-grey ground, light grey controls with
  dark ink, one yellow for what is switched on, sounding or being dragged,
  red only for what went wrong.
*/

slider1:attack_ms=30<2,250,0.1>-Attack length (ms)
slider2:xfade_ms=10<0.5,100,0.1>-Crossfade (ms)
slider3:trim_db=0<-24,24,0.1>-Attack trim (dB)
slider4:match_on=1<0,1,1{Off,On}>-Match level
slider5:align_on=1<0,1,1{Off,On}>-Align phase
slider6:onset_db=-30<-60,-6,1>-Hit threshold (dB below peak)
slider7:result_sel=0<0,1,1{A with B's attack,B with A's attack}>-Result
slider8:midi_plays=0<0,2,1{The result,Sample A,Sample B}>-MIDI notes play
slider9:out_db=0<-24,12,0.1>-Output (dB)
slider10:thru_on=1<0,1,1{Off,On}>-Pass input audio through
slider11:find_on=1<0,1,1{Off,On}>-Find attack
slider12:snap_on=0<0,1,1{Off,On}>-Snap to zero crossings

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
gfx_ext_retina = 1;

// ---- Memory: four sounds, each planar stereo -------------------------------
MAXLEN = 800000;              // frames per sound: 16.6 s at 48 kHz
CHUNK = 65536;
PEAKW = 4096;                 // widest waveform drawn, in pixels
NV = 8;                       // voices

A_L = 0;            A_R = MAXLEN;
B_L = 2 * MAXLEN;   B_R = 3 * MAXLEN;
H1_L = 4 * MAXLEN;  H1_R = 5 * MAXLEN;   // A's body, B's attack
H2_L = 6 * MAXLEN;  H2_R = 7 * MAXLEN;   // B's body, A's attack
SCRATCH = 8 * MAXLEN;                     // 2 * MAXLEN: loading, printing
CHUNKBUF = 10 * MAXLEN;
PEAKS = CHUNKBUF + CHUNK;                 // 3 rows of min/max per pixel
TABLES = PEAKS + 3 * 2 * PEAKW;

v_src = TABLES; v_pos = v_src + NV; v_gain = v_pos + NV; v_on = v_gain + NV;
// Per sound: 0 = A, 1 = B, 2 = A with B's attack, 3 = B with A's attack
s_L = v_on + NV; s_R = s_L + 4; s_len = s_R + 4; s_on = s_len + 4;
s_pk = s_on + 4; s_fsr = s_pk + 4; s_nch = s_fsr + 4; s_err = s_nch + 4;
s_lag = s_err + 4; s_pol = s_lag + 4; s_gain = s_pol + 4;
s_tend = s_gain + 4;                      // A and B: where the attack ends (0 if not found)
s_att = s_tend + 4; s_xf = s_att + 4; s_s0 = s_xf + 4;   // results: their splice
FOCUS = s_s0 + 4;                         // the window's controls, in Tab order
ATK = FOCUS + 64;                         // find_attack_end's working space, 3 x 300

s_L[0] = A_L;  s_R[0] = A_R;
s_L[1] = B_L;  s_R[1] = B_R;
s_L[2] = H1_L; s_R[2] = H1_R;
s_L[3] = H2_L; s_R[3] = H2_R;

// ---- The house colours ------------------------------------------------------
ACCENT = 0xFFF200;   ACC_HOVER = 0xFFF42E; ACC_HELD = 0xD1C600;
CONTROL = 0xA9AFBA;  C_HOVER = 0xC0C6CF;   C_HELD = 0x8F96A2;
GROUND = 0x23272E;   SUNKEN = 0x1A1D23;    FRAME_ACT = 0x2A2F37;
RULE = 0x3A404A;     INK = 0x14171C;       TEXT = 0xDDE1E7;
DIM = 0x8A919C;      FAINT = 0x6D7581;     ROLL = 0x111419;
ROW = 0x1C2026;      UNUSED = 0x646B77;    WARN = 0xD2483F;
PLAYHEAD = ACCENT;
// Text colours that meet Apple's contrast targets on every ground here:
// LABEL2 (secondary text) 7.3:1, WARN_TEXT (errors) 7.5:1. The house red
// itself is only 3.4:1 on the ground, so it marks things but isn't text.
LABEL2 = 0xB0B6C0;   WARN_TEXT = 0xFF9E96;

SPLICE_ID = 100;

// ---- Small helpers ------------------------------------------------------------
function db2g(db) ( 10 ^ (db / 20); );
function clamp(v, lo, hi) ( max(lo, min(hi, v)); );

// The attack length, the crossfade, and where the crossfade starts, in
// samples after the hit. The crossfade starts where the attack ends, so
// all of the attack is kept whole (decision 0012).
function calc_splice()
(
  att_s = max(1, floor(attack_ms * 0.001 * srate));
  xf_s = max(1, floor(xfade_ms * 0.001 * srate));
  s0_s = att_s;
);

// ---- Loading ------------------------------------------------------------------
function herm(buf, idx, fr, n) local(xm1, x0, x1, x2, c1, c2, c3)
(
  xm1 = idx > 0 ? buf[idx - 1] : 0;
  x0 = idx < n ? buf[idx] : 0;
  x1 = idx + 1 < n ? buf[idx + 1] : 0;
  x2 = idx + 2 < n ? buf[idx + 2] : 0;
  c1 = 0.5 * (x1 - xm1);
  c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;
  c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * fr + c2) * fr + c1) * fr + x0;
);

// Zero-phase 4th-order low-pass (a Butterworth biquad, forwards then back),
// so a sample going down in rate doesn't fold its top octave back in.
function lowpass(buf, n, fc, fs) local(w0, cw, al, b0, b1, b2, a1, a2, a0, x1, x2, y1, y2, i, x, y)
(
  w0 = 2 * $pi * fc / fs; cw = cos(w0); al = sin(w0) / (2 * 0.70710678);
  a0 = 1 + al;
  b0 = (1 - cw) * 0.5 / a0; b1 = (1 - cw) / a0; b2 = b0;
  a1 = -2 * cw / a0; a2 = (1 - al) / a0;
  x1 = x2 = y1 = y2 = 0; i = 0;
  loop(n,
    x = buf[i];
    y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
    x2 = x1; x1 = x; y2 = y1; y1 = y;
    buf[i] = y;
    i += 1;
  );
  x1 = x2 = y1 = y2 = 0; i = n - 1;
  loop(n,
    x = buf[i];
    y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
    x2 = x1; x1 = x; y2 = y1; y1 = y;
    buf[i] = y;
    i -= 1;
  );
);

// Reads any file REAPER can, into planar stereo at the project's rate. Mono
// is copied to both sides; more than two channels fold down, odd channels
// left and even right. Returns the length in frames, 0 if it couldn't.
function load_into(path, dL, dR, slot)
  local(h, nch, fsr, avail, frames, pos, n, k, c, sl, sr2, ptr, ratio, outlen, i, x, idx, rawL, rawR, cf)
(
  outlen = 0;
  h = file_open(path);
  h >= 0 ? (
    nch = 0; fsr = 0;
    file_riff(h, nch, fsr);
    (nch >= 1 && fsr > 0) ? (
      avail = file_avail(h);
      frames = min(floor(avail / nch), MAXLEN);
      rawL = SCRATCH; rawR = SCRATCH + MAXLEN;
      cf = floor(CHUNK / nch);
      pos = 0;
      while (pos < frames) (
        n = min(cf, frames - pos);
        file_mem(h, CHUNKBUF, n * nch);
        ptr = CHUNKBUF; k = 0;
        nch == 1 ? (
          loop(n, rawL[pos + k] = rawR[pos + k] = ptr[k]; k += 1; );
        ) : nch == 2 ? (
          loop(n, rawL[pos + k] = ptr[0]; rawR[pos + k] = ptr[1]; ptr += 2; k += 1; );
        ) : (
          loop(n,
            sl = sr2 = 0; c = 0;
            loop(nch, (c & 1) ? (sr2 += ptr[c]) : (sl += ptr[c]); c += 1; );
            rawL[pos + k] = sl / ceil(nch / 2);
            rawR[pos + k] = sr2 / floor(nch / 2);
            ptr += nch; k += 1;
          );
        );
        pos += n;
      );

      ratio = fsr / srate;
      abs(ratio - 1) < 0.000001 ? (
        memcpy(dL, rawL, frames); memcpy(dR, rawR, frames);
        outlen = frames;
      ) : (
        ratio > 1.0001 ? (
          lowpass(rawL, frames, 0.45 * srate, fsr);
          lowpass(rawR, frames, 0.45 * srate, fsr);
        );
        outlen = frames > 0 ? min(floor((frames - 1) / ratio) + 1, MAXLEN) : 0;
        i = 0;
        loop(outlen,
          x = i * ratio; idx = floor(x);
          dL[i] = herm(rawL, idx, x - idx, frames);
          dR[i] = herm(rawR, idx, x - idx, frames);
          i += 1;
        );
      );
      s_fsr[slot] = fsr;
      s_nch[slot] = nch;
    );
    file_close(h);
  );
  outlen;
);

// The file's name without its folder.
function base_name(dst, path) local(i, c)
(
  i = strlen(path) - 1;
  while (i >= 0 && ((c = str_getchar(path, i)) != 47) && (c != 92)) ( i -= 1; );
  strcpy_substr(dst, path, i + 1);
);

function load_slot(slot) local(n)
(
  slot == 0 ? (
    n = strlen(#pathA) ? load_into(#pathA, A_L, A_R, 0) : 0;
    base_name(#nameA, #pathA);
    s_err[0] = strlen(#pathA) && n == 0;
  ) : (
    n = strlen(#pathB) ? load_into(#pathB, B_L, B_R, 1) : 0;
    base_name(#nameB, #pathB);
    s_err[1] = strlen(#pathB) && n == 0;
  );
  s_len[slot] = n;
  s_err[slot] ? (
    sprintf(#status, "Couldn't read %s. Drop a WAV, AIFF, FLAC, MP3 or OGG file instead.", slot == 0 ? #nameA : #nameB);
    status_warn = 1;
  );
  loaded_sr = srate;
  onset_stale = 1;
  dirty = 1;
);

// Swaps a slot's file for another (or for none), remembering the old one so
// the change can be undone. Call begin_change() first.
function begin_change() ( undo_mask = 0; strcpy(#status, ""); status_warn = 0; );
function replace_slot(slot, path) local(had)
(
  slot == 0 ? (
    had = s_len[0] > 0 || s_err[0]; strcpy(#u_pathA, #pathA); strcpy(#pathA, path);
  ) : (
    had = s_len[1] > 0 || s_err[1]; strcpy(#u_pathB, #pathB); strcpy(#pathB, path);
  );
  had ? (undo_mask |= slot == 0 ? 1 : 2);
  load_slot(slot);
  (had && !s_err[slot]) ? (
    strlen(path) ?
      sprintf(#status, "Replaced sample %s with %s.", slot == 0 ? "A" : "B", slot == 0 ? #nameA : #nameB) :
      sprintf(#status, "Cleared sample %s.", slot == 0 ? "A" : "B");
  );
);

function clear_slot(slot) ( begin_change(); replace_slot(slot, ""); );

function undo_change() local(m)
(
  m = undo_mask; begin_change();
  (m & 1) ? (strcpy(#pathA, #u_pathA); load_slot(0););
  (m & 2) ? (strcpy(#pathB, #u_pathB); load_slot(1););
);

// ---- Analysis ---------------------------------------------------------------------
// Where the hit starts: the first sample within onset_db of the peak.
function find_onset(src) local(bl, br, n, pk, i, a, thr)
(
  bl = s_L[src]; br = s_R[src]; n = s_len[src];
  pk = 0; i = 0;
  loop(n, a = max(abs(bl[i]), abs(br[i])); a > pk ? (pk = a); i += 1; );
  s_pk[src] = pk;
  thr = pk * db2g(onset_db);
  i = 0;
  while (i < n && max(abs(bl[i]), abs(br[i])) < thr) ( i += 1; );
  s_on[src] = i < n ? i : 0;
);

function region_peak(bl, br, n, i0, i1) local(pk, i, a)
(
  pk = 0; i = max(i0, 0); i1 = min(i1, n);
  while (i < i1) ( a = max(abs(bl[i]), abs(br[i])); a > pk ? (pk = a); i += 1; );
  pk;
);

// Where a sample's attack ends, in samples after its hit, or 0 if no end is
// found within 250 ms (decision 0012). The earlier of two measures, taken
// a millisecond at a time over the first 300 ms:
//  - level: a fast follower of the level (2 ms) falls back below a slow one
//    (20 ms), after the hit had pushed it above. The level is held over
//    +-6 ms first, so a low note's waveform isn't mistaken for a decay.
//  - brightness: what is above 2.5 kHz falls 20 dB below its own peak. A
//    click or pick is bright; a low body hardly reaches up there, so this
//    finds the click's end even when the body is louder.
function find_attack_end(src)
  local(bl, br, n, on, blk, nb, lv, hv, hh, i, j, k, a, x, y, x1, x2, y1, y2,
        w0, cw, al, a0, b0, b1, b2, a1, a2, hold, af, as, f, sl, armed, end1, end2, pk, pki, thr)
(
  bl = s_L[src]; br = s_R[src]; n = s_len[src]; on = s_on[src];
  blk = max(1, floor(0.001 * srate));
  nb = max(0, min(floor((n - on) / blk), 300));
  lv = ATK; hv = ATK + 300; hh = ATK + 600;

  // High-pass at 2.5 kHz (a Butterworth biquad), started 5 ms before the hit.
  w0 = 2 * $pi * 2500 / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678);
  a0 = 1 + al;
  b0 = (1 + cw) * 0.5 / a0; b1 = -(1 + cw) / a0; b2 = b0;
  a1 = -2 * cw / a0; a2 = (1 - al) / a0;
  x1 = x2 = y1 = y2 = 0;
  i = max(0, on - 5 * blk);
  loop(on - i,
    x = (bl[i] + br[i]) * 0.5;
    y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
    x2 = x1; x1 = x; y2 = y1; y1 = y;
    i += 1;
  );
  // The peak of each millisecond: level, and brightness.
  k = 0;
  loop(nb,
    lv[k] = hv[k] = 0;
    loop(blk,
      x = (bl[i] + br[i]) * 0.5;
      y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
      x2 = x1; x1 = x; y2 = y1; y1 = y;
      lv[k] = max(lv[k], max(abs(bl[i]), abs(br[i])));
      hv[k] = max(hv[k], abs(y));
      i += 1;
    );
    k += 1;
  );

  // Level
  hold = 6; af = 1 - exp(-1 / 2); as = 1 - exp(-1 / 20);
  f = sl = 0; armed = 0; end1 = 0; k = 0;
  while (k < nb && !end1) (
    a = 0; j = max(0, k - hold);
    loop(min(nb, k + hold + 1) - j, a = max(a, lv[j]); j += 1;);
    f += af * (a - f); sl += as * (a - sl);
    !armed ? ((f > sl * 1.1) ? (armed = 1)) : ((f < sl) ? (end1 = max(1, k - hold)));
    k += 1;
  );

  // Brightness, if there is any to speak of (within 40 dB of the peak).
  pk = 0; pki = 0; k = 0;
  loop(nb,
    hh[k] = max(hv[max(0, k - 1)], max(hv[k], hv[min(nb - 1, k + 1)]));
    hh[k] > pk ? (pk = hh[k]; pki = k;);
    k += 1;
  );
  end2 = 0;
  pk > s_pk[src] * 0.01 ? (
    thr = pk * 0.1;
    k = pki;
    while (k < nb && !end2) ( hh[k] < thr ? (end2 = max(1, k)); k += 1; );
  );

  k = (end1 && end2) ? min(end1, end2) : max(end1, end2);
  s_tend[src] = k > 0 ? clamp(k * blk, floor(0.002 * srate), floor(0.25 * srate)) : 0;
);

// The attack of sound a, the body of sound b, into sound d.
function make_hybrid(d, a, b)
  local(dL, dR, aL, aR, aN, aOn, bL, bR, bN, bOn, pre, g, pol, lag, maxlag, best, l, t, c, ea, eb,
        va, vb, r, len, i, p, wa, wb, nm, ai, bi, pka, pkb, cw, i1, bi1, cnt, pk, y,
        att, xf, s0, W, ra, rb, bt, cost)
(
  dL = s_L[d]; dR = s_R[d];
  aL = s_L[a]; aR = s_R[a]; aN = s_len[a]; aOn = s_on[a];
  bL = s_L[b]; bR = s_R[b]; bN = s_len[b]; bOn = s_on[b];

  pre = min(aOn, floor(0.005 * srate));

  // The splice: where the attack sample's attack ends, if Find attack found
  // it, else the Attack length setting.
  att = (find_on && s_tend[a] > 0) ? s_tend[a] : att_s;
  xf = max(1, floor(xfade_ms * 0.001 * srate));
  s0 = att;

  g = db2g(trim_db);
  match_on ? (
    pka = region_peak(aL, aR, aN, aOn - pre, aOn + att);
    pkb = region_peak(bL, bR, bN, bOn - pre, bOn + att);
    (pka > 0.000001 && pkb > 0.000001) ? (g *= pkb / pka);
  );

  // Find how alike the two are across the splice, and with "Align phase"
  // the lag (and polarity) at which they are most alike.
  maxlag = align_on ? floor(0.0025 * srate) : 0;
  cw = min(xf, max(16, floor(0.01 * srate)));
  best = -1; lag = 0; r = 0;
  l = -maxlag;
  loop(2 * maxlag + 1,
    c = ea = eb = 0; t = s0;
    loop(cw,
      ai = aOn + t; bi = bOn + t + l;
      va = ai < aN ? aL[ai] + aR[ai] : 0;
      vb = (bi >= 0 && bi < bN) ? bL[bi] + bR[bi] : 0;
      c += va * vb; ea += va * va; eb += vb * vb;
      t += 1;
    );
    nm = ea * eb > 0 ? c / sqrt(ea * eb) : 0;
    abs(nm) > best ? (best = abs(nm); lag = l; r = nm;);
    l += 1;
  );
  pol = 1;
  align_on ? (r < 0 ? (pol = -1); r = abs(r);) : (r = max(r, 0));

  // Snap to zero crossings: within 5 ms, the point where both sounds are
  // nearest zero together (each measured against its own level there), the
  // nearer the better. The crossfade starts there.
  snap_on ? (
    W = floor(0.005 * srate);
    ra = rb = 0; t = max(1, att - W);
    loop(att + W + 1 - t,
      ai = aOn + t; bi = bOn + t + lag;
      va = ai < aN ? aL[ai] + aR[ai] : 0;
      vb = (bi >= 0 && bi < bN) ? bL[bi] + bR[bi] : 0;
      ra += va * va; rb += vb * vb;
      t += 1;
    );
    ra = sqrt(ra / (2 * W + 1)) + 0.000000001; rb = sqrt(rb / (2 * W + 1)) + 0.000000001;
    best = 1000000000; bt = att; t = max(1, att - W);
    loop(att + W + 1 - t,
      ai = aOn + t; bi = bOn + t + lag;
      va = ai < aN ? aL[ai] + aR[ai] : 0;
      vb = (bi >= 0 && bi < bN) ? bL[bi] + bR[bi] : 0;
      cost = abs(va) / ra + abs(vb) / rb + 0.5 * abs(t - att) / W;
      cost < best ? (best = cost; bt = t;);
      t += 1;
    );
    att = bt;
    s0 = att;
  );

  len = min(pre + max(bN - bOn - lag, s0 + xf), MAXLEN);
  pk = 0;

  // The attack, before the crossfade.
  i = 0;
  loop(min(pre + s0, len),
    ai = aOn + i - pre;
    ai < aN ? (dL[i] = g * pol * aL[ai]; dR[i] = g * pol * aR[ai];) : (dL[i] = dR[i] = 0;);
    pk = max(pk, max(abs(dL[i]), abs(dR[i])));
    i += 1;
  );

  // The crossfade: power held for however alike the two are (r).
  loop(min(xf, len - i),
    t = i - pre;
    ai = aOn + t; bi = bOn + t + lag;
    p = (t - s0 + 0.5) / xf;
    wa = cos(p * $pi * 0.5); wb = sin(p * $pi * 0.5);
    nm = 1 / sqrt(wa * wa + wb * wb + 2 * r * wa * wb);
    wa *= g * pol * nm * (ai < aN);
    wb *= nm * (bi >= 0 && bi < bN);
    ai = min(ai, aN - 1); bi = clamp(bi, 0, bN - 1);
    dL[i] = wa * aL[ai] + wb * bL[bi];
    dR[i] = wa * aR[ai] + wb * bR[bi];
    pk = max(pk, max(abs(dL[i]), abs(dR[i])));
    i += 1;
  );

  // The body, as it was.
  i1 = i;
  bi1 = bOn + (i1 - pre) + lag;
  bi1 < 0 ? (
    cnt = min(-bi1, len - i1);
    memset(dL + i1, 0, cnt); memset(dR + i1, 0, cnt);
    i1 += cnt; bi1 += cnt;
  );
  cnt = max(0, min(len - i1, bN - bi1));
  memcpy(dL + i1, bL + bi1, cnt); memcpy(dR + i1, bR + bi1, cnt);
  i1 + cnt < len ? (memset(dL + i1 + cnt, 0, len - i1 - cnt); memset(dR + i1 + cnt, 0, len - i1 - cnt););

  s_on[d] = pre;
  s_pk[d] = max(pk, region_peak(bL, bR, bN, bOn + s0 + xf + lag, bN));
  s_lag[d] = lag; s_pol[d] = pol; s_gain[d] = g;
  s_att[d] = att; s_xf[d] = xf; s_s0[d] = s0;
  s_len[d] = len;
);

function recompute()
(
  calc_splice();
  (onset_stale || onset_db != used_onset_db) ? (
    s_len[0] > 0 ? (find_onset(0); find_attack_end(0);) : (s_on[0] = s_pk[0] = s_tend[0] = 0);
    s_len[1] > 0 ? (find_onset(1); find_attack_end(1);) : (s_on[1] = s_pk[1] = s_tend[1] = 0);
    used_onset_db = onset_db;
    onset_stale = 0;
  );
  (s_len[0] > 0 && s_len[1] > 0) ? (
    make_hybrid(2, 1, 0);
    make_hybrid(3, 0, 1);
  ) : (
    s_len[2] = s_len[3] = 0;
  );
  dirty = 0;
  view_ver += 1;
);

// Loading and recomputing, wherever they are due. Runs from @gfx while the
// window is open, and from @block when it isn't.
function housekeeping()
(
  (loaded_sr != srate && (strlen(#pathA) || strlen(#pathB))) ? (need_load = 1);
  need_load ? (need_load = 0; load_slot(0); load_slot(1););
  dirty ? recompute();
);

// ---- Playing ------------------------------------------------------------------------
function start_voice(src, gain, delay) local(v)
(
  s_len[src] > 0 ? (
    v = next_v; next_v = (next_v + 1) % NV;
    v_src[v] = src; v_pos[v] = -delay; v_gain[v] = gain; v_on[v] = 1;
    last_v = v;
  );
);

function audition(src)
(
  s_len[src] > 0 ? (ui_trig_src = src; ui_trig += 1;);
);

function print_result() local(src, n, i, bl, br)
(
  src = 2 + result_sel; n = min(s_len[src], MAXLEN);
  n > 0 ? (
    bl = s_L[src]; br = s_R[src]; i = 0;
    loop(n, SCRATCH[2 * i] = bl[i]; SCRATCH[2 * i + 1] = br[i]; i += 1;);
    export_buffer_to_project(SCRATCH, n, 2, srate, -1, 0);
    begin_change();
    strcpy(#status, result_sel == 0 ? "Printed A with B's attack as a new item." : "Printed B with A's attack as a new item.");
  );
);

// ---- Drawing --------------------------------------------------------------------------
function cola(c, a) ( gfx_set(((c >> 16) & 255) / 255, ((c >> 8) & 255) / 255, (c & 255) / 255, a); );
function col(c) ( cola(c, 1); );
// c laid over bg at opacity a, as one solid colour: shapes drawn in pieces
// (a rounded rectangle is five) would otherwise darken where they overlap.
function mix(c, bg, a)
(
  floor(((c >> 16) & 255) * a + ((bg >> 16) & 255) * (1 - a) + 0.5) * 65536 +
  floor(((c >> 8) & 255) * a + ((bg >> 8) & 255) * (1 - a) + 0.5) * 256 +
  floor((c & 255) * a + (bg & 255) * (1 - a) + 0.5);
);

function fill_round(x, y, w, h, r)
(
  r = min(r, min(w, h) * 0.5);
  r >= 1 ? (
    gfx_rect(x + r, y, w - 2 * r, h);
    gfx_rect(x, y + r, r, h - 2 * r);
    gfx_rect(x + w - r, y + r, r, h - 2 * r);
    gfx_circle(x + r, y + r, r, 1, 1);
    gfx_circle(x + w - r - 1, y + r, r, 1, 1);
    gfx_circle(x + r, y + h - r - 1, r, 1, 1);
    gfx_circle(x + w - r - 1, y + h - r - 1, r, 1, 1);
  ) : gfx_rect(x, y, w, h);
);

function frame(x, y, w, h)
(
  gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h);
);

function dashed_frame(x, y, w, h) local(i, d)
(
  d = 6 * S;
  i = 0; while (i < w) ( gfx_rect(x + i, y, min(d, w - i), 1); gfx_rect(x + i, y + h - 1, min(d, w - i), 1); i += 2 * d; );
  i = 0; while (i < h) ( gfx_rect(x, y + i, 1, min(d, h - i)); gfx_rect(x + w - 1, y + i, 1, min(d, h - i)); i += 2 * d; );
);

function text(str, x, y, w, h, flags) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, flags, x + w, y + h); );

// The system's own typeface where there is one: Segoe UI on Windows, San
// Francisco on macOS, else Arial. gfx_getfont names the face the system
// actually gave back, so a missing font is caught rather than guessed.
function pick_font()
(
  gfx_setfont(1, "Segoe UI", 14, 0); gfx_getfont(#got);
  matchi("Segoe UI*", #got) ? strcpy(#ui_font, "Segoe UI") : (
    gfx_setfont(1, ".AppleSystemUIFont", 14, 0); gfx_getfont(#got);
    (matchi("*System*", #got) || matchi("*SF*", #got)) ? strcpy(#ui_font, ".AppleSystemUIFont") : strcpy(#ui_font, "Arial");
  );
  font_ready = 1;
);
// Sizes from Apple's macOS defaults: 13 pt text, nothing under 10 pt.
function font_body() ( gfx_setfont(1, #ui_font, 14 * S, 0); );
function font_small() ( gfx_setfont(2, #ui_font, 13 * S, 0); );
function font_label() ( gfx_setfont(3, #ui_font, 14 * S, 'b'); );

// Draws a string cut short with an ellipsis if it would be wider than w.
function text_fit(str, x, y, w, h) local(tw, th, n, c)
(
  gfx_measurestr(str, tw, th);
  tw <= w ? text(str, x, y, w, h, 4) : (
    n = strlen(str);
    while (n > 1 && tw > w) (
      n -= 1;
      // Never cut a UTF-8 character in half.
      while (n > 1 && (c = str_getchar(str, n)) >= -128 && c < -64) ( n -= 1; );
      strcpy_substr(#fit, str, 0, n); strcat(#fit, "…");
      gfx_measurestr(#fit, tw, th);
    );
    text(#fit, x, y, w, h, 4);
  );
);

function hit(x, y, w, h) ( mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h; );

function set_hint(str) ( hint_on = 1; strcpy(#hint, str); );

// ---- Keyboard focus ----------------------------------------------------------------------
// Every control that can be used registers itself as it is drawn, so Tab
// moves through them in reading order: top to bottom, left to right.
function focusable(id) ( FOCUS[fl_n] = id; fl_n = min(fl_n + 1, 63); );
function focus_ring(x, y, w, h)
(
  col(TEXT);
  gfx_roundrect(x - 3 * S, y - 3 * S, w + 5 * S, h + 5 * S, 6 * S);
  gfx_roundrect(x - 2 * S, y - 2 * S, w + 3 * S, h + 3 * S, 5 * S);
);
// Return or Space presses the focused control.
function key_activates(id) ( (focus_id == id && (key == 13 || key == 32)) ? (key = 0; 1) : 0; );

// ---- Controls --------------------------------------------------------------------------
// Where the i-th control goes in the grid (laid out in @gfx).
function cell_x(i) ( pad + (i % cols) * (cw + cg); );
function cell_y(i) ( ctrl_y + floor(i / cols) * crow_h; );

// 1: play (a triangle), 2: stop (a square), drawn in the current colour.
function draw_icon(icon, x, cy) local(r)
(
  r = 5 * S;
  icon == 1 ? gfx_triangle(x, cy - r, x, cy + r, x + 1.8 * r, cy) :
  icon == 2 ? gfx_rect(x, cy - r + S, 2 * r - 2 * S, 2 * r - 2 * S);
);

// A button: light grey with ink, yellow when it is on. Returns 1 when
// clicked, or pressed from the keyboard.
function ui_button(id, x, y, w, h, label, on, enabled, icon) local(hov, hov2, press, clicked, c, tw, th, iw, x0)
(
  enabled ? focusable(id);
  hov = enabled && hit(x, y, w, h);
  (m_click && hov) ? (ui_active = id);
  hov2 = hov && (ui_active == 0 || ui_active == id);
  press = hov && ui_active == id && m_down;
  clicked = enabled && ((ui_active == id && m_up && hit(x, y, w, h)) || key_activates(id));
  c = on ? (press ? ACC_HELD : (hov2 ? ACC_HOVER : ACCENT)) : (press ? C_HELD : (hov2 ? C_HOVER : CONTROL));
  c = enabled ? c : mix(c, GROUND, 0.35);
  col(c); fill_round(x, y, w, h, 4 * S);
  col(enabled ? INK : mix(INK, c, 0.5)); gfx_roundrect(x, y, w - 1, h - 1, 4 * S);
  font_body();
  icon ? (
    gfx_measurestr(label, tw, th); iw = 9 * S;
    x0 = x + floor((w - iw - 7 * S - tw) / 2);
    draw_icon(icon, x0, floor(y + h / 2));
    text(label, x0 + iw + 7 * S, y, x + w - x0 - iw - 7 * S, h, 4);
  ) : text(label, x, y, w, h, 1 | 4);
  focus_id == id ? focus_ring(x, y, w, h);
  clicked;
);

// A checkbox and its label. Returns the new state.
function ui_toggle(id, x, y, w, label, on, help) local(hov, bs, bx, by, res)
(
  focusable(id);
  bs = 16 * S; bx = x; by = y + floor((28 * S - bs) / 2);
  hov = hit(x, y, w, 28 * S);
  (hov || focus_id == id) ? set_hint(help);
  (m_click && hov) ? (ui_active = id);
  res = on;
  ((ui_active == id && m_up && hov) || key_activates(id)) ? (res = !on);
  col(on ? ACCENT : ((hov && (ui_active == 0 || ui_active == id)) ? C_HOVER : CONTROL));
  fill_round(bx, by, bs, bs, 3 * S);
  col(INK); gfx_roundrect(bx, by, bs - 1, bs - 1, 3 * S);
  on ? (
    gfx_line(bx + 4 * S, by + 8 * S, bx + 7 * S, by + 11 * S, 1);
    gfx_line(bx + 7 * S, by + 11 * S, bx + 12 * S, by + 5 * S, 1);
    gfx_line(bx + 4 * S, by + 9 * S, bx + 7 * S, by + 12 * S, 1);
    gfx_line(bx + 7 * S, by + 12 * S, bx + 12 * S, by + 6 * S, 1);
  );
  font_body(); col(TEXT); text(label, bx + bs + 8 * S, y, w - bs - 8 * S, 28 * S, 4);
  focus_id == id ? focus_ring(bx, by, bs, bs);
  res;
);

// A slider with its name and value above it. Click or drag on the track to
// set it, scroll or use the arrow keys to nudge (Shift for finer), double-
// click to put it back. Returns the value.
function ui_slider(id, x, y, w, label, fmt, val, lo, hi, def, islog, help)
  local(tx, ty, tw, u, u0, kx, hov, nv, now, k)
(
  focusable(id);
  font_small(); col(LABEL2); text(label, x, y, w, 16 * S, 4);
  sprintf(#sl_txt, fmt, val);
  col(TEXT); text(#sl_txt, x, y, w, 16 * S, 2 | 4);

  ty = y + 30 * S; tx = x + 8 * S; tw = max(1, w - 16 * S);
  hov = hit(x, y + 16 * S, w, 28 * S);
  (hov || ui_active == id || focus_id == id) ? set_hint(help);
  (m_click && hov) ? (
    now = time_precise();
    (now - ui_lastclick < 0.35 && ui_lastid == id) ? (ui_reset = id);
    ui_lastclick = now; ui_lastid = id; ui_active = id;
  );
  nv = val;
  (ui_active == id && m_down) ? (
    ui_reset == id ? (nv = def) : (
      u = clamp((mouse_x - tx) / tw, 0, 1);
      nv = islog ? lo * (hi / lo) ^ u : lo + u * (hi - lo);
    );
  );
  k = (hov && mouse_wheel != 0 && ui_active == 0) ? (mouse_wheel > 0 ? 2 : -2) : 0;
  k != 0 ? (mouse_wheel = 0);
  focus_id == id ? (
    (key == 'rght' || key == 'up') ? (k = 1; key = 0;);
    (key == 'left' || key == 'down') ? (k = -1; key = 0;);
  );
  k != 0 ? (
    u = islog ? log(val / lo) / log(hi / lo) : (val - lo) / (hi - lo);
    u = clamp(u + k * ((mouse_cap & 8) ? 0.001 : 0.01), 0, 1);
    nv = islog ? lo * (hi / lo) ^ u : lo + u * (hi - lo);
    // Always move at least one step of what is shown.
    floor(nv * 10 + 0.5) / 10 == val ? (nv = clamp(val + sign(k) * 0.1, lo, hi));
  );
  nv = floor(nv * 10 + 0.5) / 10;

  u = clamp(islog ? log(nv / lo) / log(hi / lo) : (nv - lo) / (hi - lo), 0, 1);
  u0 = (lo < 0 && hi > 0) ? -lo / (hi - lo) : 0;
  col(SUNKEN); fill_round(tx, ty - 2 * S, tw, 4 * S, 2 * S);
  col(ui_active == id ? CONTROL : FAINT); fill_round(tx + min(u, u0) * tw, ty - 2 * S, abs(u - u0) * tw, 4 * S, 2 * S);
  kx = tx + u * tw;
  col(ui_active == id ? C_HELD : ((hov && ui_active == 0) ? C_HOVER : CONTROL));
  gfx_circle(kx, ty, 7 * S, 1, 1);
  col(INK); gfx_circle(kx, ty, 7 * S, 0, 1);
  focus_id == id ? focus_ring(x - 2 * S, y - 2 * S, w + 4 * S, 46 * S);
  nv;
);

// ---- Waveforms ----------------------------------------------------------------------------
// Every row shares one time axis, in samples from the hit, so the hits and
// the splice line up down the window.
function build_peaks(v, src, w) local(base, n, on, bl, br, i, a, b, j, step, mn, mx, tpp, x)
(
  base = PEAKS + v * 2 * PEAKW;
  n = s_len[src]; on = s_on[src]; bl = s_L[src]; br = s_R[src];
  tpp = (view_t1 - view_t0) / w;
  i = 0;
  loop(min(w, PEAKW),
    a = floor(on + view_t0 + i * tpp); b = floor(on + view_t0 + (i + 1) * tpp);
    b = max(b, a + 1);
    a = max(a, 0); b = min(b, n);
    mn = mx = 0;
    a < b ? (
      step = max(1, floor((b - a) / 64));
      j = a;
      while (j < b) (
        x = bl[j]; mx = max(mx, x); mn = min(mn, x);
        x = br[j]; mx = max(mx, x); mn = min(mn, x);
        j += step;
      );
    );
    base[2 * i] = mn; base[2 * i + 1] = mx;
    i += 1;
  );
);

// role: 0 = sample A, 1 = sample B, 2 = the result. The parts of A and B
// that make it into the result are drawn light, the rest dark, and the
// labels say so in words too.
function draw_wave(v, src, x, y, w, h, role) local(base, i, n, mid, amp, t, c, ya, yb, px, prov, used, tpp, xa, xb, ok)
(
  tpp = (view_t1 - view_t0) / w;
  ok = s_len[src] > 0;
  col(ROLL); gfx_rect(x, y, w, h);
  ok ? (
    xb = clamp(x + (att_s - view_t0) / tpp, x, x + w);
    xb > x ? (col(ROW); gfx_rect(x, y, xb - x, h););
    xa = clamp(x + (s0_s - view_t0) / tpp, x, x + w);
    xb = clamp(x + (s0_s + xf_s - view_t0) / tpp, x, x + w);
    xb > xa ? (col(FRAME_ACT); gfx_rect(xa, y, xb - xa, h););

    mid = floor(y + h / 2);
    col(RULE); gfx_rect(x, mid, w, 1);
    amp = (h / 2 - 4 * S) * disp_scale;
    base = PEAKS + v * 2 * PEAKW;
    prov = result_sel == 0 ? 1 : 0;
    n = min(w, PEAKW);
    i = 0;
    loop(n,
      t = view_t0 + (i + 0.5) * tpp;
      role == 2 ? (c = t < att_s ? TEXT : CONTROL) : (
        used = (role == prov) ? (t < s0_s + xf_s) : (t >= s0_s);
        c = used ? CONTROL : UNUSED;
      );
      col(c);
      ya = max(y, mid - base[2 * i + 1] * amp);
      yb = min(y + h, mid - base[2 * i] * amp);
      gfx_rect(x + i, ya, 1, max(1, yb - ya));
      i += 1;
    );

    // The hit (a mark at the top) and, with Find attack on, where this
    // sample's attack ends (a mark at the bottom).
    px = x + (0 - view_t0) / tpp;
    (px >= x && px <= x + w) ? (col(DIM); gfx_triangle(px - 4 * S, y, px + 4 * S, y, px, y + 5 * S););
    (role < 2 && find_on && s_tend[role] > 0) ? (
      px = x + (s_tend[role] - view_t0) / tpp;
      (px >= x && px <= x + w) ? (col(LABEL2); gfx_triangle(px - 5 * S, y + h - 1, px + 5 * S, y + h - 1, px, y + h - 7 * S););
    );

    // Names over the two parts
    font_small();
    px = x + (att_s - view_t0) / tpp;
    role == 2 ? (
      (px - x > 64 * S) ? (col(TEXT); text(result_sel == 0 ? "B attack" : "A attack", x + 6 * S, y + 4 * S, px - x - 8 * S, 16 * S, 4););
      (x + w - px > 64 * S) ? (col(TEXT); text(result_sel == 0 ? "A body" : "B body", px + 6 * S, y + 4 * S, x + w - px - 8 * S, 16 * S, 4););
    ) : (
      (px - x > 48 * S) ? (col(role == prov ? TEXT : DIM); text(role == prov ? "attack" : "attack (unused)", x + 6 * S, y + 4 * S, px - x - 8 * S, 16 * S, 4););
      (x + w - px > 48 * S) ? (col(role == prov ? DIM : TEXT); text(role == prov ? "body (unused)" : "body", px + 6 * S, y + 4 * S, x + w - px - 8 * S, 16 * S, 4););
    );

    // The splice: white, wider while it can be dragged.
    (px >= x && px < x + w) ? (
      col(TEXT);
      gfx_rect(px - (splice_hot ? S : 0), y, splice_hot ? 3 * S : max(1, S), h);
      role == 2 ? (
        col(splice_hot ? TEXT : CONTROL); fill_round(px - 5 * S, y + h / 2 - 12 * S, 10 * S + 1, 24 * S, 3 * S);
        col(INK); gfx_roundrect(px - 5 * S, y + h / 2 - 12 * S, 10 * S, 24 * S, 3 * S);
      );
    );

    // What is sounding
    (play_on && play_src == src) ? (
      px = x + (play_pos - s_on[src] - view_t0) / tpp;
      (px >= x && px < x + w) ? (col(PLAYHEAD); gfx_rect(px, y, max(1, S), h););
    );
    col(RULE); frame(x, y, w, h);
  ) : (
    col(FAINT); dashed_frame(x, y, w, h);
    font_body();
    (role < 2 && s_err[role]) ? (
      col(WARN_TEXT);
      sprintf(#werr, "Couldn't read %s.", role == 0 ? #nameA : #nameB);
      text(#werr, x, y, w, h / 2, 1 | 8);
      col(LABEL2); text("Drop a WAV, AIFF, FLAC, MP3 or OGG file here.", x, y + h / 2 + 4 * S, w, 20 * S, 1);
    ) : (
      col(LABEL2);
      text(role == 2 ? "The result appears here once both samples are in." :
           role == 0 ? "Drop sample A here, or two files at once." : "Drop sample B here.",
           x, y, w, h, 1 | 4);
    );
  );
);

function draw_ruler(x, y, w) local(span, st, k, n, t, px, tpp)
(
  span = (view_t1 - view_t0) / srate * 1000;
  st = 0.1; k = 0;
  while (k < 40 && st / span * w < 70 * S) ( st *= (k % 3 == 1) ? 2.5 : 2; k += 1; );
  tpp = (view_t1 - view_t0) / w;
  n = ceil(view_t0 / srate * 1000 / st);
  font_small();
  while ((t = n * st) <= view_t1 / srate * 1000) (
    px = x + (t * 0.001 * srate - view_t0) / tpp;
    col(FAINT); gfx_rect(px, y, max(1, S), 4 * S);
    col(LABEL2);
    abs(t) >= 1000 ? sprintf(#rl, "%g s", floor(t / 10 + 0.5) / 100) : sprintf(#rl, "%g ms", floor(t * 10 + 0.5) / 10);
    text(#rl, px + 3 * S, y, 90 * S, 16 * S, 4);
    n += 1;
  );
);

function draw_source_panel(slot, x, y, w, h) local(cs, playing)
(
  cs = 28 * S;
  col(CONTROL); fill_round(x, y, cs, cs, 4 * S);
  col(INK); gfx_roundrect(x, y, cs - 1, cs - 1, 4 * S);
  font_label(); text(slot == 0 ? "A" : "B", x, y, cs, cs, 1 | 4);

  (s_len[slot] > 0 || s_err[slot]) ? (
    col(TEXT); text_fit(slot == 0 ? #nameA : #nameB, x + cs + 8 * S, y, w - cs - 8 * S, cs);
    // The whole name, however long, when the pointer is over it.
    hit(x, y, w, cs) ? set_hint(slot == 0 ? #nameA : #nameB);
  ) : (
    col(LABEL2); text(slot == 0 ? "Sample A" : "Sample B", x + cs + 8 * S, y, w - cs - 8 * S, cs, 4);
  );

  font_small();
  s_err[slot] ? (
    col(WARN_TEXT); text("Couldn't read this file.", x, y + cs + 6 * S, w, 18 * S, 4);
  ) : s_len[slot] > 0 ? (
    sprintf(#meta, "%.2f s · %g kHz%s", s_len[slot] / srate, s_fsr[slot] / 1000, s_nch[slot] == 1 ? " · mono" : "");
    col(LABEL2); text_fit(#meta, x, y + cs + 6 * S, w, 18 * S);
  ) : (
    col(LABEL2); text("No sample yet", x, y + cs + 6 * S, w, 18 * S, 4);
  );

  playing = play_on && play_src == slot;
  ui_button(10 + slot, x, y + 60 * S, w, 28 * S, playing ? "Stop" : (slot == 0 ? "Play A" : "Play B"),
            playing, s_len[slot] > 0, playing ? 2 : 1) ? (playing ? (ui_stop += 1) : audition(slot));
);

ui_active = 0;
view_mode = 1;
ui_zoom = 1;

@slider
dirty = 1;

@block
// While the window is closed (or after a project loads) nothing else will
// load or recompute, so do it here.
(time_precise() - gfx_seen > 0.5) ? housekeeping();

ui_trig != ui_trig_seen ? (ui_trig_seen = ui_trig; start_voice(ui_trig_src, 1, 0););
ui_stop != ui_stop_seen ? (ui_stop_seen = ui_stop; memset(v_on, 0, NV););

while (midirecv(ofs, m1, m2, m3)) (
  ((m1 & 0xF0) == 0x90 && m3 > 0) ? (
    start_voice(midi_plays == 0 ? 2 + result_sel : midi_plays - 1, m3 / 127, ofs);
  );
  midisend(ofs, m1, m2, m3);
);

outg = db2g(out_db);

@sample
out_l = thru_on ? spl0 : 0;
out_r = thru_on ? spl1 : 0;
vi = 0;
loop(NV,
  v_on[vi] ? (
    vp = v_pos[vi];
    vp >= 0 ? (
      vs = v_src[vi];
      vp < s_len[vs] ? (
        vbl = s_L[vs]; vbr = s_R[vs];
        out_l += vbl[vp] * v_gain[vi] * outg;
        out_r += vbr[vp] * v_gain[vi] * outg;
      ) : (v_on[vi] = 0);
    );
    v_pos[vi] = vp + 1;
  );
  vi += 1;
);
spl0 = out_l;
spl1 = out_r;
play_on = v_on[last_v];
play_src = v_src[last_v];
play_pos = v_pos[last_v];

@serialize
file_string(0, #pathA);
file_string(0, #pathB);
file_var(0, view_mode);
file_var(0, ui_zoom);
file_avail(0) >= 0 ? (need_load = 1);

@gfx 820 704
gfx_seen = time_precise();
!font_ready ? pick_font();
ui_zoom < 1 ? (ui_zoom = 1);
S = max(1, gfx_ext_retina) * ui_zoom;
housekeeping();

key = gfx_getchar();
m_down = mouse_cap & 1;
m_click = m_down && !m_last;
m_up = !m_down && m_last;
m_last = m_down;
m_click ? (focus_id = 0);    // pointing takes over from the keyboard
hint_on = 0;
cursor = 32512;
fl_n = 0;

// ---- Layout --------------------------------------------------------------------------------
// Top to bottom: a bar for messages and Options, the controls, then the
// waveforms. Nothing that matters sits at the bottom edge, which Apple notes
// often ends up off the screen.
pad = 16 * S;
gap = 12 * S;
bar_h = 28 * S;
cg = 24 * S;
cols = clamp(floor((gfx_w - 2 * pad + cg) / (170 * S + cg)), 2, 4);
cw = floor((gfx_w - 2 * pad - (cols - 1) * cg) / cols);
crow_h = 64 * S;
ctrl_y = pad + bar_h + 18 * S;
ctrl_h = ceil(10 / cols) * crow_h - 12 * S;
sep_y = ctrl_y + ctrl_h + 10 * S;
labw = 172 * S;
wx = pad + labw + 16 * S;
ww = max(16, floor(gfx_w - wx - pad));
area_y = sep_y + 16 * S;
area_h = max(2 * 88 * S + 132 * S + 2 * gap, gfx_h - area_y - pad - 22 * S);
rowR_h = max(132 * S, floor((area_h - 2 * gap) * 1.3 / 3.3));
rh = max(88 * S, floor((area_h - 2 * gap - rowR_h) / 2));
rowA_y = area_y;              rowA_h = rh;
rowB_y = rowA_y + rh + gap;   rowB_h = rh;
rowR_y = rowB_y + rh + gap;
ruler_y = rowR_y + rowR_h + 4 * S;

col(GROUND); gfx_rect(0, 0, gfx_w, gfx_h);

// ---- Dropped files --------------------------------------------------------------------------
// One file goes to the row it was dropped on (or the first empty one); two go
// to A and B. Whatever they replace can be put back with Undo.
gfx_getdropfile(0, #drop) ? (
  begin_change();
  gfx_getdropfile(1, #drop2) ? (
    replace_slot(0, #drop); replace_slot(1, #drop2);
    (undo_mask == 3 && !status_warn) ? strcpy(#status, "Replaced both samples.");
  ) : (
    target = hit(0, rowB_y, gfx_w, rowB_h) ? 1 :
             hit(0, rowA_y, gfx_w, rowA_h) ? 0 :
             s_len[0] == 0 ? 0 : s_len[1] == 0 ? 1 : 0;
    replace_slot(target, #drop);
  );
  gfx_getdropfile(-1);
  housekeeping();
);

// ---- What the rows show ----------------------------------------------------------------------
// The splice drawn is the chosen result's own (found and snapped as it was
// made), or the Attack length setting while there is no result.
calc_splice();
s_len[2 + result_sel] > 0 ? (
  att_s = s_att[2 + result_sel]; xf_s = s_xf[2 + result_sel]; s0_s = s_s0[2 + result_sel];
);
ui_active != SPLICE_ID ? (
  view_mode == 0 ? (
    any = 0; view_t0 = -0.005 * srate; view_t1 = 0.25 * srate;
    i = 0;
    loop(3,
      si = i < 2 ? i : 2 + result_sel;
      s_len[si] > 0 ? (
        any ? (
          view_t0 = min(view_t0, -s_on[si]); view_t1 = max(view_t1, s_len[si] - s_on[si]);
        ) : (
          view_t0 = -s_on[si]; view_t1 = s_len[si] - s_on[si]; any = 1;
        );
      );
      i += 1;
    );
    view_t0 -= 0.002 * srate;
  ) : view_mode == 1 ? (
    view_t0 = -0.006 * srate;
    view_t1 = max(0.04 * srate, 2.5 * att_s + xf_s);
  ) : (
    view_t0 = cv0; view_t1 = cv1;
  );
);

// Scroll over the waveforms to zoom around the pointer.
(mouse_wheel != 0 && hit(wx, rowA_y, ww, rowR_y + rowR_h - rowA_y)) ? (
  tm = view_t0 + (mouse_x - wx) / ww * (view_t1 - view_t0);
  zf = 0.85 ^ (mouse_wheel / 120);
  cv0 = tm - (tm - view_t0) * zf; cv1 = tm + (view_t1 - tm) * zf;
  (cv1 - cv0 < 0.004 * srate) ? (cv0 = tm - 0.002 * srate; cv1 = tm + 0.002 * srate;);
  (cv1 - cv0 > 60 * srate) ? (cv0 = tm - 30 * srate; cv1 = tm + 30 * srate;);
  view_t0 = cv0; view_t1 = cv1; view_mode = 2;
  mouse_wheel = 0;
);

(pk_ver != view_ver || pk_t0 != view_t0 || pk_t1 != view_t1 || pk_w != ww || pk_sel != result_sel) ? (
  build_peaks(0, 0, ww);
  build_peaks(1, 1, ww);
  build_peaks(2, 2 + result_sel, ww);
  pk_ver = view_ver; pk_t0 = view_t0; pk_t1 = view_t1; pk_w = ww; pk_sel = result_sel;
);
disp_scale = 1 / max(0.001, max(s_pk[0], max(s_pk[1], s_pk[2 + result_sel])));

any_loaded = s_len[0] > 0 || s_len[1] > 0;
splice_x = wx + (att_s - view_t0) / (view_t1 - view_t0) * ww;
splice_hot = ui_active == SPLICE_ID ||
             (ui_active == 0 && any_loaded && hit(splice_x - 10 * S, rowA_y, 20 * S, rowR_y + rowR_h - rowA_y));
ready = s_len[2 + result_sel] > 0;
playing_r = play_on && play_src == 2 + result_sel;

// ---- The bar: messages stay until dismissed, with Undo when it applies --------------------------------
opt_x = gfx_w - pad - 96 * S;
status_on = strlen(#status) > 0;
dis_x = opt_x - 12 * S - 84 * S;
undo_x = dis_x - 12 * S - 72 * S;
msg_right = (status_on ? (undo_mask ? undo_x : dis_x) : opt_x) - 12 * S;
(status_on && undo_mask) ? (ui_button(31, undo_x, pad, 72 * S, bar_h, "Undo", 0, 1, 0) ? undo_change(););
status_on ? (ui_button(32, dis_x, pad, 84 * S, bar_h, "Dismiss", 0, 1, 0) ? (strcpy(#status, ""); undo_mask = 0;););

ui_button(30, opt_x, pad, 96 * S, bar_h, "Options", 0, 1, 0) ? (
  gfx_x = opt_x; gfx_y = pad + bar_h;
  sprintf(#menu, "%sPass input audio through||%sMIDI notes play the result|%sMIDI notes play sample A|%sMIDI notes play sample B||%sInterface size 100%%|%sInterface size 125%%|%sInterface size 150%%|%sInterface size 200%%||%sClear sample A|%sClear sample B",
          thru_on ? "!" : "", midi_plays == 0 ? "!" : "", midi_plays == 1 ? "!" : "", midi_plays == 2 ? "!" : "",
          ui_zoom == 1 ? "!" : "", ui_zoom == 1.25 ? "!" : "", ui_zoom == 1.5 ? "!" : "", ui_zoom == 2 ? "!" : "",
          s_len[0] > 0 || s_err[0] ? "" : "#", s_len[1] > 0 || s_err[1] ? "" : "#");
  menu_sel = gfx_showmenu(#menu);
  menu_sel == 1 ? (thru_on = !thru_on; slider_automate(512);) :
  (menu_sel >= 2 && menu_sel <= 4) ? (midi_plays = menu_sel - 2; slider_automate(128);) :
  (menu_sel >= 5 && menu_sel <= 8) ? (ui_zoom = menu_sel == 5 ? 1 : menu_sel == 6 ? 1.25 : menu_sel == 7 ? 1.5 : 2;) :
  menu_sel == 9 ? clear_slot(0) :
  menu_sel == 10 ? clear_slot(1);
);

// ---- Controls ----------------------------------------------------------------------------------------
// Attack length shows the splice the result really has: what Find attack
// found, or the setting and, if snapping moved it, where it went. Moving it
// is a choice made by hand, so it turns Find attack off.
att_found = find_on && s_len[2 + result_sel] > 0 && s_tend[result_sel == 0 ? 1 : 0] > 0;
att_shown = att_found ? floor(att_s / srate * 10000 + 0.5) / 10 : attack_ms;
att_found ? strcpy(#att_fmt, "%.1f ms, found") :
  (s_len[2 + result_sel] > 0 && abs(att_s / srate * 1000 - attack_ms) >= 0.05) ?
    sprintf(#att_fmt, "%%.1f → %.1f ms", att_s / srate * 1000) : strcpy(#att_fmt, "%.1f ms");
nv = ui_slider(1, cell_x(0), cell_y(0), cw, "Attack length", #att_fmt, att_shown, 2, 250, 30, 1,
               "Attack length: how much of the start is taken from the attack sample. Moving it turns Find attack off.");
nv != att_shown ? (
  attack_ms = clamp(nv, 2, 250); slider_automate(1); dirty = 1;
  find_on ? (find_on = 0; slider_automate(1024););
);

nv = ui_slider(2, cell_x(1), cell_y(1), cw, "Crossfade", "%.1f ms", xfade_ms, 0.5, 100, 10, 1,
               "Crossfade: how long the attack takes to blend into the body.");
nv != xfade_ms ? (xfade_ms = nv; slider_automate(2); dirty = 1;);

nv = ui_slider(3, cell_x(2), cell_y(2), cw, "Attack trim", "%+.1f dB", trim_db, -24, 24, 0, 0,
               "Attack trim: turns the borrowed attack up or down.");
nv != trim_db ? (trim_db = nv; slider_automate(4); dirty = 1;);

nv = ui_slider(4, cell_x(3), cell_y(3), cw, "Output", "%+.1f dB", out_db, -24, 12, 0, 0,
               "Output: the level of what plays here. Printing isn't affected.");
nv != out_db ? (out_db = nv; slider_automate(256););

nv = ui_slider(5, cell_x(4), cell_y(4), cw, "Hit threshold", "%.0f dB", onset_db, -60, -6, -30, 0,
               "Hit threshold: how near its peak a sample must get before its hit counts as started.");
nv = floor(nv + 0.5);
nv != onset_db ? (onset_db = nv; slider_automate(32); dirty = 1;);

nv = ui_toggle(14, cell_x(5), cell_y(5) + 16 * S, cw, "Find attack", find_on,
               "Find attack: measures where the attack sample's attack ends, and splices there. The marks under A and B show where each one's attack ends.");
nv != find_on ? (find_on = nv; slider_automate(1024); dirty = 1;);

nv = ui_toggle(15, cell_x(6), cell_y(6) + 16 * S, cw, "Snap to zero crossings", snap_on,
               "Snap to zero crossings: moves the splice up to 5 ms, to where both sounds cross zero together, so the join doesn't click.");
nv != snap_on ? (snap_on = nv; slider_automate(2048); dirty = 1;);

nv = ui_toggle(6, cell_x(7), cell_y(7) + 16 * S, cw, "Match level", match_on,
               "Match level: sets the borrowed attack to the peak of the attack it replaces.");
nv != match_on ? (match_on = nv; slider_automate(8); dirty = 1;);

nv = ui_toggle(7, cell_x(8), cell_y(8) + 16 * S, cw, "Align phase", align_on,
               "Align phase: shifts the body up to 2.5 ms, or flips it, so the two don't cancel at the splice.");
nv != align_on ? (align_on = nv; slider_automate(16); dirty = 1;);

vx = cell_x(9); vy = cell_y(9);
font_small(); col(LABEL2); text("View", vx, vy, cw, 16 * S, 4);
vbw = floor((cw - 12 * S) / 2);
ui_button(8, vx, vy + 16 * S, vbw, 28 * S, "Attack", view_mode == 1, 1, 0) ? (view_mode = 1);
ui_button(9, vx + vbw + 12 * S, vy + 16 * S, cw - vbw - 12 * S, 28 * S, "Whole", view_mode == 0, 1, 0) ? (view_mode = 0);
(hit(vx, vy + 16 * S, cw, 28 * S) || focus_id == 8 || focus_id == 9) ? set_hint("View: zoom in on the splice, or see all of each sound. Scroll over the waveforms to zoom.");

col(RULE); gfx_rect(pad, sep_y, gfx_w - 2 * pad, max(1, S));

// ---- Rows ----------------------------------------------------------------------------------------
draw_source_panel(0, pad, rowA_y, labw, rowA_h);
draw_source_panel(1, pad, rowB_y, labw, rowB_h);

font_label(); col(TEXT); text("Result", pad, rowR_y, labw, 22 * S, 4);
ui_button(20, pad, rowR_y + 28 * S, labw, 28 * S, "A with B's attack", result_sel == 0, 1, 0) ? (result_sel = 0; slider_automate(64););
ui_button(21, pad, rowR_y + 64 * S, labw, 28 * S, "B with A's attack", result_sel == 1, 1, 0) ? (result_sel = 1; slider_automate(64););
bw = floor((labw - 12 * S) / 2);
ui_button(22, pad, rowR_y + 104 * S, bw, 28 * S, playing_r ? "Stop" : "Play", playing_r, ready, playing_r ? 2 : 1) ?
  (playing_r ? (ui_stop += 1) : audition(2 + result_sel));
ui_button(23, pad + bw + 12 * S, rowR_y + 104 * S, labw - bw - 12 * S, 28 * S, "Print", 0, ready, 0) ? print_result();
(hit(pad + bw + 12 * S, rowR_y + 104 * S, labw - bw - 12 * S, 28 * S) || focus_id == 23) ?
  set_hint("Print: adds the result to the project as a new item.");

draw_wave(0, 0, wx, rowA_y, ww, rowA_h, 0);
draw_wave(1, 1, wx, rowB_y, ww, rowB_h, 1);
draw_wave(2, 2 + result_sel, wx, rowR_y, ww, rowR_h, 2);
any_loaded ? draw_ruler(wx, ruler_y, ww);

// Clicking a waveform plays it; the splice line drags (Attack length does
// the same from the keyboard).
splice_hot ? (
  cursor = 32644;
  set_hint("Drag the line to choose how much of the attack is borrowed.");
) : (any_loaded && ui_active == 0 && hit(wx, rowA_y, ww, rowR_y + rowR_h - rowA_y)) ? (
  set_hint("Click a waveform to hear it. Scroll to zoom.");
);
(m_click && ui_active == 0) ? (
  splice_hot ? (ui_active = SPLICE_ID) :
  hit(wx, rowA_y, ww, rowA_h) ? (ui_active = 40; audition(0)) :
  hit(wx, rowB_y, ww, rowB_h) ? (ui_active = 41; audition(1)) :
  hit(wx, rowR_y, ww, rowR_h) ? (ui_active = 42; audition(2 + result_sel));
);
(ui_active == SPLICE_ID && m_down) ? (
  nv = clamp((view_t0 + (mouse_x - wx) / ww * (view_t1 - view_t0)) / srate * 1000, 2, 250);
  nv = floor(nv * 10 + 0.5) / 10;
  nv != attack_ms ? (attack_ms = nv; slider_automate(1); dirty = 1;);
  find_on ? (find_on = 0; slider_automate(1024); dirty = 1;);
);

// ---- Keys --------------------------------------------------------------------------------------------
// Tab and Shift+Tab move between controls; Return or Space presses one;
// arrows move a slider. With nothing focused, Space plays or stops the result.
key == 9 ? (
  fl_n > 0 ? (
    cur = -1; i = 0;
    loop(fl_n, FOCUS[i] == focus_id ? (cur = i); i += 1;);
    (mouse_cap & 8) ? (cur = cur <= 0 ? fl_n - 1 : cur - 1) : (cur = cur < 0 ? 0 : (cur + 1) % fl_n);
    focus_id = FOCUS[cur];
  );
) :
key == 27 ? (focus_id = 0; ui_stop += 1;) :
key == 32 ? (playing_r ? (ui_stop += 1) : audition(2 + result_sel)) :
key == 49 ? (result_sel = 0; slider_automate(64);) :
key == 50 ? (result_sel = 1; slider_automate(64);) :
(key == 97 || key == 65) ? audition(0) :
(key == 98 || key == 66) ? audition(1);

// ---- The bar's text: a message, else what's under the pointer, else what to do next ---------------------------
font_body();
status_on ? (
  col(status_warn ? WARN_TEXT : TEXT); text_fit(#status, pad, pad, msg_right - pad, bar_h);
) : hint_on ? (
  col(LABEL2); text_fit(#hint, pad, pad, msg_right - pad, bar_h);
) : (
  col(LABEL2);
  text_fit(s_len[0] == 0 && s_len[1] == 0 ? "Drop two samples on the window. The result takes A's body and B's attack." :
           s_len[0] == 0 || s_len[1] == 0 ? "Now drop the other sample." :
           "Click a waveform to hear it. Drag the white line to set the attack length.",
           pad, pad, msg_right - pad, bar_h);
);

gfx_setcursor(cursor, "arrow");
m_up ? (ui_active = 0; ui_reset = 0;);
mouse_wheel = 0;
